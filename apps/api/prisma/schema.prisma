// Schema Prisma di Prome — un solo database Postgres, uno schema per bounded
// context (più "cancellazione" per il registro delle cancellazioni account).
// Tutti gli schemi hanno ora i propri modelli: "gruppo", creato vuoto nella
// migration iniziale, è stato popolato con E7.
//
// Nota: multiSchema è GA in Prisma 6 — il flag previewFeatures non serve più
// (Prisma emetteva un warning di deprecazione, quindi è stato rimosso).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["accesso", "profilo", "bacheca", "gruppo", "aula_studio", "cancellazione", "segnalazione"]
}

// ---------------------------------------------------------------------------
// Schema "accesso" — tabelle del fornitore di identità, non del dominio.
//
// L'architettura dice che Accesso non è un contesto modellato e non possiede
// dati di dominio. Queste tabelle non lo contraddicono: sono l'archivio
// interno del fornitore di identità (account, sessioni, codici in attesa), e
// il loro vocabolario si ferma qui. Nessun modulo di dominio le legge —
// l'unico punto di contatto è PortaIdentitàUtente, che da tutto questo estrae
// un identificativo e nient'altro.
//
// Stanno in uno schema loro proprio per la stessa ragione per cui i contesti
// hanno il proprio: così "nessun dominio legge accesso" è una regola che il
// motore può imporre, non una promessa.
//
// I **nomi dei modelli** sono quelli attesi dal fornitore (User, Session,
// Account, Verification) e non seguono la nomenclatura del progetto: sono il
// suo vocabolario, non il nostro, e rinominarli significherebbe mantenere a
// mano una mappatura che si rompe in silenzio al primo aggiornamento. I nomi
// delle tabelle invece sono in italiano, perché quelli li legge chi apre il
// database. Si rigenerano con `pnpm --filter @prome/api accesso:schema`.
// ---------------------------------------------------------------------------

/// Account autenticato. `name` e `image` appartengono al fornitore: il dominio
/// non li legge, i dati anagrafici stanno in profilo.Profilo.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("utente")
  @@schema("accesso")
}

/// Sessione attiva. Il token è quello che il client rimanda a ogni richiesta.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessione")
  @@schema("accesso")
}

/// Collegamento a un metodo di ingresso. Oggi ce n'è uno solo — l'email con
/// codice — ma la tabella regge anche i provider esterni, se torneranno.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credenziale")
  @@schema("accesso")
}

/// Codice OTP in attesa di verifica. Il valore è conservato con hash: chi
/// legge il database non può usarlo per entrare.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifica")
  @@schema("accesso")
}

/// Identità accademica dell'utente (bounded context Profilo).
/// utenteId arriva dal fornitore di identità, non è generato qui: è un
/// identificativo nudo, senza foreign key verso lo schema accesso, perché fra
/// contesti non si attraversano gli schemi.
model Profilo {
  utenteId             String   @id
  nome                 String?
  cognome              String?

  /// Il Corso universitario, scelto dal catalogo: **l'unico riferimento
  /// accademico del profilo**. L'Università non ha una colonna propria — il
  /// corso appartiene già a un ateneo, e una seconda colonna sarebbe una
  /// seconda risposta alla stessa domanda, destinata a divergere. Chi filtra
  /// per ateneo attraversa la relazione (`corso: { universitaId }`).
  corsoId              String?

  /// La chiave della foto del profilo nell'archivio, o null se non ce n'è una.
  ///
  /// La chiave **non contiene l'identificativo dell'utente** (come tutte le
  /// altre), ma a differenza degli allegati questo file **muore con
  /// l'account**: è il ritratto di una persona, non un contenuto che resta
  /// dietro un autore anonimizzato. Lo si ritrova per cancellarlo leggendo
  /// questa colonna prima di eliminare la riga.
  fotoChiave String?

  /// La chiave appena pre-autorizzata, in attesa che i byte arrivino.
  ///
  /// Sta qui e non in una tabella di prenotazioni (come per gli allegati)
  /// perché la foto è **una sola**: la seconda pre-autorizzazione sovrascrive
  /// la prima, e non resta niente da ripulire. È anche ciò che rende
  /// verificabile la conferma — si accetta solo la chiave che il server ha
  /// emesso per questa persona, non una qualunque che arrivi dal client.
  fotoChiaveInAttesa String?

  onboardingCompletato Boolean  @default(false)
  creatoIl             DateTime @default(now())
  aggiornatoIl         DateTime @default(now()) @updatedAt

  /// Valorizzato mentre esiste una richiesta di cancellazione pendente: il
  /// profilo «scompare subito» (visibilità e letture lo escludono) senza
  /// essere eliminato, così un nuovo accesso entro la grazia lo riattiva
  /// intatto, impostazioni comprese. Scritto SOLO dalla catena di
  /// cancellazione attraverso ProfiloService.
  inCancellazioneDal DateTime?

  /// `Restrict` e non il `SetNull` di prestito: un corso con iscritti non si
  /// elimina per sbaglio, e soprattutto la sua eliminazione non deve poter
  /// lasciare in giro profili «con onboarding completato» e senza corso —
  /// sarebbero persone che smettono di vedere l'ateneo senza sapere perché.
  corso               Corso?                  @relation(fields: [corsoId], references: [id], onDelete: Restrict)
  impostazioniPrivacy ImpostazioniDiPrivacy?
  preferenzeNotifiche PreferenzeDiNotifica?
  dispositivi         DispositivoDiNotifica[]
  notifiche           Notifica[]
  blocchiFatti        Blocco[]                @relation("bloccante")
  blocchiSubiti       Blocco[]                @relation("bloccato")

  @@index([corsoId])
  @@map("profilo")
  @@schema("profilo")
}

// --- Catalogo accademico ---------------------------------------------------
//
// Università, Classe di corso e Corso sono **dati del Profilo** (glossario del
// domain model), quindi vivono nel suo schema e li possiede il suo modulo: un
// contesto a parte sarebbe una modifica della Context Map, e in cambio
// perderebbe le foreign key — che qui servono, perché un profilo non deve
// poter puntare a un corso che non esiste.
//
// Il catalogo è **chiuso**: si sceglie da un elenco, non si scrive. Le sue
// righe NON sono dati personali — nessuna porta un utenteId, la cancellazione
// dell'account non le tocca e la verifica del residuo non le conta.

/// Un ateneo.
///
/// Lo `slug` è lo stesso delle pagine pubbliche (`@prome/contenuti`): il
/// giorno in cui l'hub di ateneo leggerà dall'API non servirà una mappatura
/// scritta a mano fra due elenchi che nel frattempo sono divergiti.
model Universita {
  id           String   @id @default(uuid())
  slug         String   @unique
  nome         String   @unique
  nomeBreve    String
  citta        String
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @default(now()) @updatedAt

  corsi Corso[]

  @@map("universita")
  @@schema("profilo")
}

/// La classe ministeriale di un corso: elenco chiuso, condiviso fra atenei.
///
/// Sta in tabella propria perché «tutti gli iscritti alla classe L-18, in ogni
/// ateneo» è una delle domande per cui questo catalogo esiste: con due colonne
/// sul corso sarebbe un raggruppamento su testo ripetuto ateneo per ateneo, e
/// basta una maiuscola diversa perché la stessa classe si conti due volte.
model ClasseDiCorso {
  /// 'L-18', 'L-18 R', 'LM-77'. È il codice ministeriale: identifica la classe
  /// nel mondo, non solo qui dentro, e per questo è la chiave.
  codice  String         @id
  nome    String
  livello LivelloDiCorso

  corsi Corso[]

  @@map("classe_di_corso")
  @@schema("profilo")
}

/// Il livello del titolo, derivato dalla classe e non dal singolo corso: tutti
/// i corsi di una classe rilasciano lo stesso titolo.
enum LivelloDiCorso {
  TRIENNALE
  MAGISTRALE
  CICLO_UNICO

  @@map("livello_di_corso")
  @@schema("profilo")
}

/// Un corso di studi di un ateneo.
model Corso {
  id           String @id @default(uuid())
  universitaId String
  /// Codice assegnato dall'ateneo (es. 6612): unico **dentro l'ateneo**, non
  /// nel mondo — due atenei possono usare lo stesso numero.
  codice       String
  nome         String
  classeCodice String
  durataAnni   Int

  /// Un corso disattivato non si può più scegliere, ma i profili che lo citano
  /// restano validi: si governa il presente, non si riscrive il passato. È il
  /// motivo per cui la semina non cancella mai una riga.
  attivo Boolean @default(true)

  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @default(now()) @updatedAt

  universita Universita    @relation(fields: [universitaId], references: [id])
  classe     ClasseDiCorso @relation(fields: [classeCodice], references: [codice])
  profili    Profilo[]

  @@unique([universitaId, codice])
  @@index([universitaId, nome])
  @@index([classeCodice])
  @@map("corso")
  @@schema("profilo")
}

/// Chi non vuole più vedere chi, in bacheca.
///
/// Posseduto da Profilo perché è una decisione della persona sulle proprie
/// letture, come le impostazioni di privacy — e come quelle si interroga
/// **alla lettura**, mai propagata e mai in cache (SE2: il cambio vale alla
/// lettura successiva, senza finestra).
///
/// La chiave primaria composta È l'idempotenza (stile G3): bloccare due volte
/// la stessa persona è un'operazione senza effetto, non un errore. Le due
/// cascate portano via la riga alla cancellazione di **uno qualunque** dei
/// due profili — e il residuo va comunque contato in entrambe le direzioni,
/// perché una verifica che non guarda una colonna si dichiara totale senza
/// esserlo.
///
/// Vale per la sola bacheca — la superficie non scelta. Dentro un'aula o un
/// gruppo, dove entrambi hanno scelto di stare, restano l'uscita e la
/// moderazione: filtrare per coppia una stanza condivisa romperebbe le
/// conversazioni e il modello del trasporto, che consegna per stanza.
model Blocco {
  bloccanteId String
  bloccatoId  String
  creatoIl    DateTime @default(now())

  bloccante Profilo @relation("bloccante", fields: [bloccanteId], references: [utenteId], onDelete: Cascade)
  bloccato  Profilo @relation("bloccato", fields: [bloccatoId], references: [utenteId], onDelete: Cascade)

  @@id([bloccanteId, bloccatoId])
  @@index([bloccatoId])
  @@map("blocco")
  @@schema("profilo")
}

/// Chi può contattarti e chi vede i tuoi contenuti.
///
/// Due assi indipendenti, mai riassunti in un "livello di privacy" unico:
/// il dominio lo vieta esplicitamente (IP3), e ogni combinazione dei due è
/// legittima. Nascono **nella stessa scrittura del Profilo** e partono dal
/// valore più chiuso: un default permissivo esporrebbe i contenuti di chi non
/// ha ancora avuto modo di scegliere.
model ImpostazioniDiPrivacy {
  utenteId       String      @id
  contattabilita Visibilita  @default(PRIVATO)
  visibilita     Visibilita  @default(PRIVATO)
  aggiornatoIl   DateTime    @default(now()) @updatedAt

  profilo Profilo @relation(fields: [utenteId], references: [utenteId], onDelete: Cascade)

  @@map("impostazioni_di_privacy")
  @@schema("profilo")
}

/// Quali avvisi la persona vuole ricevere fuori dall'app.
///
/// **Non sono impostazioni di privacy** e non stanno con loro: la privacy dice
/// chi può vedere e contattare, questa dice cosa si vuole sapere. Mescolarle
/// reintrodurrebbe il «livello» unico che il dominio ha rifiutato (IP3).
///
/// Nascono con il Profilo e partono **accese**, al contrario della privacy: un
/// avviso che non arriva non espone nulla a nessuno, mentre un avviso che non
/// arriva perché nessuno lo ha acceso fa sembrare il prodotto morto. Si
/// spengono con un gesto, e quel gesto ha effetto alla prima notifica dopo.
model PreferenzeDiNotifica {
  utenteId String @id

  /// Qualcuno ha commentato un mio contenuto.
  commenti Boolean @default(true)
  /// Sono stato invitato in un'aula studio o in un gruppo.
  inviti   Boolean @default(true)

  aggiornatoIl DateTime @default(now()) @updatedAt

  profilo Profilo @relation(fields: [utenteId], references: [utenteId], onDelete: Cascade)

  @@map("preferenze_di_notifica")
  @@schema("profilo")
}

/// Un dispositivo su cui recapitare gli avvisi.
///
/// Il token è **rilasciato dalla piattaforma**, non da noi: su iOS il trasporto
/// è quello imposto dal sistema, e nessun meccanismo proprio è ammesso. Qui se
/// ne conserva il minimo — a chi appartiene, su quale piattaforma, da quando —
/// perché è comunque un dato che identifica un apparecchio di una persona, e
/// cade con il profilo.
model DispositivoDiNotifica {
  id       String @id @default(uuid())
  utenteId String
  /// Unico: lo stesso dispositivo registrato due volte è una registrazione
  /// sola, non due destinatari.
  token    String @unique
  piattaforma PiattaformaDiNotifica

  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @default(now()) @updatedAt

  profilo Profilo @relation(fields: [utenteId], references: [utenteId], onDelete: Cascade)

  @@index([utenteId])
  @@map("dispositivo_di_notifica")
  @@schema("profilo")
}

enum PiattaformaDiNotifica {
  IOS
  ANDROID
  WEB

  @@map("piattaforma_di_notifica")
  @@schema("profilo")
}

/// La notifica in-app: la riga che la campanella conta e l'elenco mostra.
///
/// Nasce SEMPRE (salvo autore uguale al destinatario e coppie bloccate): le
/// preferenze qui sopra governano i canali che interrompono — l'email, domani
/// il push — mai questa riga. Chi apre la campanella vede tutto, chi spegne un
/// asse chiede solo di non essere interrotto.
///
/// Non porta dati personali: né l'autore, né testi risolti — il client traduce
/// dal `tipo`, e la risorsa si apre dentro l'app, dove le regole di visibilità
/// valgono ancora. È la stessa scelta del payload push.
model Notifica {
  id             String @id @default(uuid())
  destinatarioId String

  /// Cosa è successo: decide il testo che il client mostra.
  tipo TipoDiNotifica

  /// Dove porta il tocco: ogni client costruisce il proprio percorso da qui.
  /// Due campi distinti dal tipo, perché domani un tipo nuovo può puntare a
  /// una risorsa che esiste già.
  risorsaTipo RisorsaDiNotifica
  risorsaId   String

  /// Una per fatto: il commentoId per il commento, l'invitoId per gli inviti.
  /// L'unicità con il destinatario È la deduplica dell'outbox at-least-once:
  /// lo stesso fatto consegnato due volte trova la riga e si ferma lì.
  chiaveDeduplicazione String

  lettaIl      DateTime?
  creatoIl     DateTime  @default(now())
  aggiornatoIl DateTime  @default(now()) @updatedAt

  profilo Profilo @relation(fields: [destinatarioId], references: [utenteId], onDelete: Cascade)

  @@unique([destinatarioId, chiaveDeduplicazione])
  @@index([destinatarioId, creatoIl])
  @@index([destinatarioId, lettaIl])
  @@map("notifica")
  @@schema("profilo")
}

enum TipoDiNotifica {
  COMMENTO
  INVITO_AULA
  INVITO_GRUPPO

  @@map("tipo_di_notifica")
  @@schema("profilo")
}

enum RisorsaDiNotifica {
  POST
  INVITO_AULA
  INVITO_GRUPPO

  @@map("risorsa_di_notifica")
  @@schema("profilo")
}

/// I tre soli valori del linguaggio ubiquo. "Pubblico" significa aperto a
/// tutti gli studenti iscritti a Prome, mai al web.
enum Visibilita {
  PRIVATO
  ATENEO
  PUBBLICO

  @@map("visibilita")
  @@schema("profilo")
}

// ---------------------------------------------------------------------------
// Schema "bacheca" — post e allegati.
// ---------------------------------------------------------------------------

/// Post pubblicato da un Utente.
///
/// **Non ha alcun attributo di visibilità** (invariante B5): chi lo vede
/// discende dalle Impostazioni di privacy dell'autore, lette al momento della
/// lettura. Una colonna qui sarebbe una copia locale di una decisione che
/// appartiene a Profilo, e due risposte alla stessa domanda.
///
/// `autoreId` è un identificativo nudo: fra contesti non si attraversano gli
/// schemi, quindi nessuna foreign key verso profilo.
model Post {
  id           String   @id @default(uuid())
  autoreId     String
  testo        String
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @default(now()) @updatedAt

  allegati Allegato[]

  @@index([creatoIl(sort: Desc)])
  @@index([autoreId])
  @@map("post")
  @@schema("bacheca")
}

/// Allegato: entità interna al Post, non aggregato a sé.
///
/// Nasce e muore con il contenuto che accompagna, e la cascata qui sotto è
/// **l'unica dell'intero schema** (invariante B4): un allegato orfano non deve
/// poter esistere nemmeno per un istante.
///
/// `chiave` è opaca al dominio: serve a ritrovare il file attraverso la
/// capacità di archiviazione, e nient'altro — nessun fornitore è nominato.
model Allegato {
  id         String       @id @default(uuid())
  postId     String
  chiave     String       @unique
  nome       String
  tipo       TipoAllegato
  dimensione Int
  creatoIl   DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("allegato")
  @@schema("bacheca")
}

/// I tre tipi ammessi, e nessun altro (invariante B3).
enum TipoAllegato {
  PDF
  IMMAGINE
  TESTO

  @@map("tipo_allegato")
  @@schema("bacheca")
}

/// File caricato ma non ancora legato a un post.
///
/// **Non è l'`Allegato` del dominio**: è la prenotazione di una chiave fra la
/// pre-autorizzazione e la pubblicazione. Sta in una tabella separata proprio
/// perché B4 dice che un allegato senza post non deve esistere: se vivesse
/// nella stessa tabella, ogni caricamento abbandonato sarebbe un allegato
/// orfano. Qui invece è una prenotazione scaduta, e l'unità lavoratrice la
/// raccoglie insieme al file che nessuno ha adottato.
model AllegatoInAttesa {
  id         String       @id @default(uuid())
  autoreId   String
  chiave     String       @unique
  nome       String
  tipo       TipoAllegato
  dimensione Int
  creatoIl   DateTime     @default(now())

  @@index([autoreId])
  @@index([creatoIl])
  @@map("allegato_in_attesa")
  @@schema("bacheca")
}

/// Commento sotto un Post.
///
/// **Aggregato autonomo, non entità interna al Post** — è scritto in
/// concorrenza da autori diversi, e contenerlo nel Post trasformerebbe ogni
/// risposta in una modifica del Post stesso.
///
/// `postId` è un riferimento **per identità**, senza foreign key: un
/// riferimento per identità non è un vincolo di esistenza (C3). L'esistenza
/// del post si verifica quando arriva il comando, su lettura fresca, e la
/// finestra che resta aperta la chiude l'unità lavoratrice. Una cascata qui
/// darebbe la garanzia al prezzo di far competere gli autori sulla stessa
/// riga, che è precisamente ciò che il modello ha rifiutato.
model Commento {
  id           String   @id @default(uuid())
  postId       String
  autoreId     String
  testo        String
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @default(now()) @updatedAt

  @@index([postId, creatoIl])
  @@index([autoreId])
  @@map("commento")
  @@schema("bacheca")
}

/// I fatti di dominio in uscita da questo schema (pattern outbox).
///
/// **Una tabella per schema, mai una globale**, come per l'aula e per il
/// gruppo. Porta un fatto solo — un commento scritto sotto il contenuto di
/// qualcuno — e serve a una cosa precisa: l'avviso verso l'esterno parte
/// **fuori dal percorso della richiesta**, così chi scrive un commento non
/// aspetta un fornitore di notifiche per vedere il proprio commento comparire,
/// e un fornitore lento o guasto non diventa un commento fallito.
model FattoInUscitaDellaBacheca {
  /// Identificativo dell'evento: è la chiave di deduplica sul consumatore.
  id          String   @id @default(uuid())
  tipo        String
  aggregatoId String
  versione    Int      @default(1)
  accadutoIl  DateTime @default(now())
  payload     Json

  consegnatoIl        DateTime?
  tentativi           Int       @default(0)
  prossimoTentativoIl DateTime  @default(now())
  nonConsegnabileIl   DateTime?

  @@index([consegnatoIl, prossimoTentativoIl])
  @@index([accadutoIl])
  @@map("fatto_in_uscita")
  @@schema("bacheca")
}

// ---------------------------------------------------------------------------
// Schema "gruppo" — lo spazio che resta nel tempo.
//
// Un gruppo è un **contenitore di utenti con appartenenza e visibilità**, non
// un secondo spazio sociale: non ha feed, non ha chat, non ha notifiche
// proprie. È l'ipotesi in vigore dichiarata dai documenti, e il perimetro di
// E7 è esattamente quello — ciò che non è appartenenza qui non entra.
//
// Il Membro è entità interna del Gruppo, per la stessa ragione per cui il
// Partecipante sta dentro l'AulaStudio: G2 («esiste sempre almeno un
// moderatore») è un'affermazione sull'INSIEME dei membri, e nessun membro
// isolato può sapere se è l'ultimo moderatore. L'InvitoAlGruppo è invece un
// aggregato autonomo, e non condivide nulla con l'invito d'aula: ciò che si
// verifica prima di ammettere è diverso, e la duplicazione è già a bilancio.
//
// L'AlberoOrganizzativo (le cartelle, A1–A6) NON è qui: non appartiene al
// perimetro di E7 e non va aggiunto per anticipo.
// ---------------------------------------------------------------------------

/// Lo spazio persistente di un insieme di persone.
///
/// Non possiede contenuti: possiede **chi ne fa parte**. Le aule studio non
/// stanno dentro il gruppo — sono loro a dichiarare la propria collocazione
/// (`AulaStudio.gruppoId`, AS9), e il gruppo non le conosce. È la stessa
/// direzione della dipendenza che l'anti-corruption layer già dichiara: dal
/// gruppo verso l'aula passa **un booleano**, mai un elenco.
model Gruppo {
  id         String          @id @default(uuid())
  /// G1: non vuoto dopo trim. La regola vive nel costruttore del dominio.
  nome       String
  /// G5: sempre valorizzata, mai «non impostata».
  visibilita VisibilitaGruppo @default(PRIVATO)

  /// Ateneo di riferimento, precompilato dall'università del creatore alla
  /// creazione e poi CONGELATO (G5): un gruppo non cambia pubblico perché chi
  /// l'ha creato ha cambiato ateneo. L'università di chi chiede di entrare si
  /// legge invece sempre fresca dal Profilo.
  ///
  /// È l'**identificativo** dell'ateneo, non il suo nome: la regola confronta
  /// questo campo con l'università di chi legge, e due stringhe scritte in due
  /// momenti diversi non corrispondono mai in modo affidabile. Identificativo
  /// nudo, senza foreign key — qui si attraversa un confine di contesto, come
  /// per `utenteId`.
  ateneoId String?

  /// Chi ha creato il gruppo. Fatto storico: resta vero anche se quella
  /// persona esce, e non concede nulla di per sé — chi amministra è chi è
  /// moderatore adesso (G2), non chi ha creato.
  creatoDa String

  /// Blocco ottimistico, per la stessa ragione dell'aula: G2 è
  /// un'affermazione sull'insieme dei membri, e due moderatori che si
  /// retrocedono a vicenda vedrebbero, ciascuno da solo, una situazione
  /// lecita. Il conflitto lo respinge il confronto di versione.
  versione Int @default(0)

  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @default(now()) @updatedAt

  membri Membro[]

  @@index([creatoIl(sort: Desc)])
  @@map("gruppo")
  @@schema("gruppo")
}

/// I tre valori del linguaggio ubiquo, modellati **di nuovo** in questo
/// contesto: stessi tre nomi di Profilo e di AulaStudio, tre contesti
/// distinti. Se un giorno divergessero, divergerebbero senza rompere nulla.
enum VisibilitaGruppo {
  PRIVATO
  ATENEO
  PUBBLICO

  @@map("visibilita_gruppo")
  @@schema("gruppo")
}

/// Entità interna del Gruppo: chi ne fa parte, e con quale ruolo.
///
/// Il ruolo di moderatore vale **solo dentro il gruppo**: non produce alcun
/// permesso in un'aula collocata (AS6). Il core dell'aula non ha modo di
/// conoscerlo, e non deve averlo — attraversa il confine solo un booleano di
/// appartenenza.
model Membro {
  gruppoId String
  utenteId String

  /// G2: almeno uno per gruppo, sempre. L'ultimo non si rimuove né si
  /// retrocede — per uscire deve prima promuovere qualcun altro.
  moderatore Boolean @default(false)

  entratoIl DateTime @default(now())

  gruppo Gruppo @relation(fields: [gruppoId], references: [id], onDelete: Cascade)

  /// G3: un utente compare al massimo una volta fra i membri. Qui non è
  /// verificato, è **impossibile** — ed è ciò che rende la seconda aggiunta
  /// un'operazione senza effetto invece di un errore, e innocua la doppia
  /// consegna dell'accettazione di un invito.
  @@id([gruppoId, utenteId])
  @@index([utenteId])
  @@map("membro")
  @@schema("gruppo")
}

/// Invito a un gruppo. Il destinatario è un INDIRIZZO, non un utente: si
/// invita anche chi non è ancora iscritto, e l'invito lo aspetta.
model InvitoAlGruppo {
  id       String @id @default(uuid())
  /// IG1: destinatario e gruppo obbligatori e **immutabili**. Un invito non si
  /// redireziona verso un'altra persona né verso un altro gruppo: se serve
  /// invitare qualcun altro, si emette un altro invito.
  gruppoId String
  destinatario String
  invitatoDa   String
  /// IG2: dallo stato iniziale si transita una volta sola, e gli stati
  /// conclusivi sono terminali. Una seconda accettazione non ha effetto.
  stato        StatoInvitoAlGruppo @default(IN_ATTESA)
  /// Calcolato all'emissione (emissione + 7 giorni), come per l'aula.
  scadeIl      DateTime
  emessoIl     DateTime            @default(now())
  chiusoIl     DateTime?
  /// Valorizzato all'accettazione: serve al fatto che crea il membro, e a
  /// rispondere a chi sta aspettando.
  accettatoDa  String?

  @@index([gruppoId])
  @@index([destinatario])
  @@index([stato, scadeIl])
  @@map("invito_al_gruppo")
  @@schema("gruppo")
}

/// IG2 in forma di tipo: gli stati conclusivi sono terminali. Sono tre, e
/// `RIFIUTATO` è una risposta di chi è stato invitato — non una scadenza
/// anticipata, che invece accade a chi non risponde affatto.
enum StatoInvitoAlGruppo {
  IN_ATTESA
  ACCETTATO
  RIFIUTATO
  SCADUTO

  @@map("stato_invito_al_gruppo")
  @@schema("gruppo")
}

/// I fatti di dominio in uscita da questo schema (pattern outbox).
///
/// **Una tabella per schema, mai una globale**: questa è l'outbox del gruppo,
/// distinta da quella dell'aula, e il fatto si scrive nella STESSA transazione
/// dell'aggregato che lo produce. Oggi ne trasporta uno solo —
/// `MembroRimossoDalGruppo` — ed è il fatto che deve raggiungere chi è già
/// dentro un'aula collocata: quella persona non farà alcuna nuova richiesta,
/// quindi l'informazione deve andarle incontro (SE1, pochi secondi).
model FattoInUscitaDelGruppo {
  /// Identificativo dell'evento: è la chiave di deduplica sul consumatore.
  id          String   @id @default(uuid())
  tipo        String
  /// Identità dell'aggregato sorgente.
  aggregatoId String
  /// Versione del contratto del fatto.
  versione    Int      @default(1)
  accadutoIl  DateTime @default(now())
  payload     Json

  consegnatoIl        DateTime?
  tentativi           Int       @default(0)
  prossimoTentativoIl DateTime  @default(now())
  /// Valorizzato quando i tentativi sono esauriti: è l'unico caso in cui una
  /// mano umana è prevista.
  nonConsegnabileIl DateTime?

  @@index([consegnatoIl, prossimoTentativoIl])
  @@index([accadutoIl])
  @@map("fatto_in_uscita")
  @@schema("gruppo")
}

// ---------------------------------------------------------------------------
// Schema "aula_studio" — il contesto CORE: l'incontro di studio.
//
// Cinque aggregati e una sola entità interna. Il Partecipante sta DENTRO
// l'AulaStudio perché le invarianti che lo riguardano (AS2, AS3, AS4, AS5)
// sono affermazioni sull'INSIEME dei partecipanti: solo un aggregato che li
// vede tutti insieme può garantirle al commit. Argomento, Allegato, Invito e
// (in E4) MessaggioDiChat sono invece aggregati autonomi.
// ---------------------------------------------------------------------------

/// L'incontro di studio.
///
/// **Non ha alcuno stato di ciclo di vita** (AS8): non esiste «programmata»,
/// «in corso», «conclusa». La sola differenza fra un'aula programmata e una
/// estemporanea è la presenza di `dataOraInizio`, e quella data **non apre né
/// chiude nulla** — l'aula resta consultabile con i suoi argomenti e materiali
/// prima e dopo l'incontro. Aggiungere qui un campo di stato è la violazione
/// più facile da introdurre e la meno visibile: non farlo.
model AulaStudio {
  id         String              @id @default(uuid())
  titolo     String
  visibilita VisibilitaAulaStudio @default(PRIVATO)

  /// Ateneo di riferimento, precompilato dall'università del creatore alla
  /// creazione e poi CONGELATO (AS7): lo spazio non cambia pubblico perché il
  /// suo creatore ha cambiato ateneo. L'università di chi chiede di entrare si
  /// legge invece sempre fresca dal Profilo.
  ///
  /// È l'**identificativo** dell'ateneo, non il suo nome, per la stessa
  /// ragione del gruppo: la regola lo confronta, e un confronto fra stringhe
  /// scritte in momenti diversi fallisce in silenzio. Identificativo nudo,
  /// senza foreign key: fra contesti non si attraversano gli schemi.
  ateneoId String?

  /// Opzionale; se presente, alla creazione deve essere futura (AS8).
  dataOraInizio DateTime?

  /// CollocazioneNelGruppo: al più una, mai due (AS9). Identificativo nudo,
  /// nessuna foreign key: fra contesti non si attraversano gli schemi.
  gruppoId String?

  /// Blocco ottimistico. Serve perché AS2 è un'affermazione sull'insieme dei
  /// partecipanti: due moderatori che retrocedono contemporaneamente l'ultimo
  /// moderatore vedrebbero, ciascuno da solo, una situazione lecita. Il
  /// conflitto è respinto dal confronto di versione.
  versione Int @default(0)

  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @default(now()) @updatedAt

  partecipanti Partecipante[]

  @@index([creatoIl(sort: Desc)])
  @@index([gruppoId])
  @@map("aula_studio")
  @@schema("aula_studio")
}

/// I tre valori del linguaggio ubiquo, modellati **di nuovo** in questo
/// contesto e non condivisi con Profilo: stessi tre nomi, due contesti
/// distinti. Se un giorno divergessero, divergerebbero senza rompere nulla.
enum VisibilitaAulaStudio {
  PRIVATO
  ATENEO
  PUBBLICO

  @@map("visibilita_aula_studio")
  @@schema("aula_studio")
}

/// Entità interna dell'AulaStudio: chi è ammesso all'incontro, con il suo
/// ruolo e i suoi permessi.
///
/// I tre permessi sono un value object del Partecipante, non un aggregato:
/// non hanno identità né storia propria e non si consultano indipendentemente
/// da chi li possiede. **L'insieme vuoto è la Sola lettura** (AS4): uno stato
/// legittimo e normale, non un errore da correggere né un ruolo separato.
model Partecipante {
  aulaStudioId String
  utenteId     String

  /// AS5: un moderatore ha SEMPRE i tre permessi, non revocabili finché dura
  /// il ruolo. Non vale il contrario — avere i tre permessi non fa moderatore.
  moderatore Boolean @default(false)

  parlare  Boolean @default(false)
  scrivere Boolean @default(false)
  caricare Boolean @default(false)

  ammessoIl DateTime @default(now())

  aula AulaStudio @relation(fields: [aulaStudioId], references: [id], onDelete: Cascade)

  /// AS3: un utente compare al massimo una volta fra i partecipanti. È anche
  /// ciò che rende innocua la doppia consegna dell'accettazione di un invito.
  @@id([aulaStudioId, utenteId])
  @@index([utenteId])
  @@map("partecipante")
  @@schema("aula_studio")
}

/// Contenitore di materiale legato a UN incontro preciso: nasce lì e resta lì
/// (AR1, legame immutabile). Aggregato autonomo, non entità interna.
model Argomento {
  id           String   @id @default(uuid())
  aulaStudioId String
  titolo       String
  /// AR2: facoltativo, massimo 20.000 caratteri. È il posto dove si scrive di
  /// un tema di studio, non un'etichetta.
  testo        String?
  creatoIl     DateTime @default(now())
  aggiornatoIl DateTime @default(now()) @updatedAt

  @@index([aulaStudioId, creatoIl])
  @@map("argomento")
  @@schema("aula_studio")
}

/// Materiale condiviso nell'aula. Aggregato autonomo — ed è la differenza
/// sostanziale con l'Allegato del Post, che invece muore con lui (B4).
///
/// `argomentoId` è facoltativo: essere «sciolto» è uno stato normale, non un
/// ripiego, e non serve alcun argomento di default. Eliminare un argomento
/// **non cancella alcun file**: gli allegati tornano sciolti.
model AllegatoDiAulaStudio {
  id           String       @id @default(uuid())
  aulaStudioId String
  /// AL3: se valorizzato, l'argomento appartiene alla stessa aula — condizione
  /// verificata al comando, non garantita al commit.
  argomentoId  String?
  /// AL2: chi ha portato il materiale è un fatto storico e immutabile. Resta
  /// valido anche quando quel partecipante lascia l'aula, e sopravvive alla
  /// cancellazione dell'account con il solo riferimento anonimizzato.
  caricatoDa   String
  chiave       String                   @unique
  nome         String
  tipo         TipoAllegatoAulaStudio
  dimensione   Int
  creatoIl     DateTime                 @default(now())

  salvataggi MaterialeSalvato[]

  @@index([aulaStudioId, creatoIl])
  @@index([argomentoId])
  @@index([caricatoDa])
  @@map("allegato_di_aula_studio")
  @@schema("aula_studio")
}

/// Un materiale messo da parte da qualcuno: la sua raccolta personale.
///
/// Sta **nello schema dell'aula** e non in quello del profilo perché il
/// materiale è dell'aula, ed è l'Aula studio a sapere chi può vederlo: da
/// Profilo servirebbe leggere aule e partecipanti, cioè attraversare la
/// Context Map nel verso vietato.
///
/// La chiave primaria composta è l'idempotenza (come per l'appartenenza al
/// gruppo, G3): salvare due volte lo stesso materiale è **un'operazione senza
/// effetto**, non un errore da gestire.
///
/// La cascata è verso il materiale, dentro lo stesso contesto: un segnalibro a
/// un materiale che non c'è più non è un dato, è un riferimento rotto.
model MaterialeSalvato {
  /// Identificativo nudo, come ovunque si attraversi un confine di contesto.
  utenteId    String
  materialeId String
  salvatoIl   DateTime @default(now())

  materiale AllegatoDiAulaStudio @relation(fields: [materialeId], references: [id], onDelete: Cascade)

  @@id([utenteId, materialeId])
  @@index([utenteId, salvatoIl(sort: Desc)])
  @@map("materiale_salvato")
  @@schema("aula_studio")
}

/// Gli stessi tre tipi ammessi dalla Bacheca (B3), enunciati **di nuovo** e
/// non condivisi: Bacheca e Aula studio stanno in separate ways. Se un giorno
/// il limite cambiasse per il materiale d'aula e non per gli allegati dei
/// post, i due enunciati divergerebbero senza rompere nulla — ed è esattamente
/// il grado di indipendenza voluto.
enum TipoAllegatoAulaStudio {
  PDF
  IMMAGINE
  TESTO

  @@map("tipo_allegato_aula_studio")
  @@schema("aula_studio")
}

/// Invito a un'aula studio. Il destinatario è un INDIRIZZO, non un utente: si
/// invita anche chi non è ancora iscritto, e l'invito lo aspetta (IA2).
model Invito {
  id           String      @id @default(uuid())
  aulaStudioId String
  /// Immutabile (IA1): un invito non si redireziona verso un'altra persona.
  destinatario String
  invitatoDa   String
  stato        StatoInvito @default(IN_ATTESA)
  /// Calcolato all'emissione (emissione + 7 giorni) e trasportato nel payload
  /// degli eventi: chi consuma il fatto sa quando scade senza conoscere la
  /// regola dei 7 giorni.
  scadeIl      DateTime
  emessoIl     DateTime    @default(now())
  chiusoIl     DateTime?
  /// Valorizzato all'accettazione: chi ha accettato. Serve al fatto che crea
  /// il partecipante, e a rispondere al client che sta aspettando.
  accettatoDa  String?

  @@index([aulaStudioId])
  @@index([destinatario])
  @@index([stato, scadeIl])
  @@map("invito")
  @@schema("aula_studio")
}

/// IA1: dallo stato iniziale si transita una volta sola, e gli stati
/// conclusivi sono terminali. Una seconda accettazione non ha effetto, e
/// nemmeno un rifiuto dopo un'accettazione: si esce da un'aula, non si
/// disdice un invito già speso.
enum StatoInvito {
  IN_ATTESA
  ACCETTATO
  RIFIUTATO
  SCADUTO

  @@map("stato_invito")
  @@schema("aula_studio")
}

/// Un messaggio nella chat dell'aula.
///
/// Aggregato autonomo e **minuscolo**: nessuna versione, niente da
/// riconciliare, nessuna contesa fra chi scrive contemporaneamente. È
/// **immutabile dopo l'invio** (MA1) — un messaggio è un fatto, non un
/// documento — e questo è ciò che gli consente di essere così piccolo.
///
/// Il permesso di scrivere si verifica **sull'aula, su dato fresco, all'invio**
/// (MA2): revocarlo zittisce da quel momento, non cancella la conversazione.
///
/// Non condivide alcun modello con il messaggio del Gruppo, che arriverà: ciò
/// che si verifica prima di scrivere è diverso — qui un permesso, là
/// l'appartenenza — e la duplicazione è un costo già messo a bilancio.
model MessaggioDiChat {
  id           String   @id @default(uuid())
  aulaStudioId String
  autoreId     String
  testo        String
  inviatoIl    DateTime @default(now())

  @@index([aulaStudioId, inviatoIl])
  @@index([autoreId])
  @@map("messaggio_di_chat")
  @@schema("aula_studio")
}

/// I fatti di dominio in uscita da questo schema (pattern outbox).
///
/// **Una tabella per schema, mai una globale**: il fatto è scritto nella
/// STESSA transazione dell'aggregato che lo produce — o esistono entrambi, o
/// nessuno dei due. È la condizione senza la quale «0 perdite» non è
/// dimostrabile: un fatto pubblicato fuori dalla transazione è un fatto che
/// può mancare quando la scrittura riesce, o esistere quando fallisce.
///
/// I fatti consegnati si purgano dopo 7 giorni: i payload possono trasportare
/// dati personali, e una tabella conservata indefinitamente sarebbe una
/// replica priva di percorso di cancellazione.
model FattoInUscita {
  /// Identificativo dell'evento: è la chiave di deduplica sul consumatore.
  id          String   @id @default(uuid())
  tipo        String
  /// Identità dell'aggregato sorgente.
  aggregatoId String
  /// Versione del contratto del fatto.
  versione    Int      @default(1)
  accadutoIl  DateTime @default(now())
  payload     Json

  consegnatoIl        DateTime?
  tentativi           Int       @default(0)
  prossimoTentativoIl DateTime  @default(now())
  /// Valorizzato quando i tentativi sono esauriti: è l'unico caso in cui una
  /// mano umana è prevista.
  nonConsegnabileIl   DateTime?

  @@index([consegnatoIl, prossimoTentativoIl])
  @@index([accadutoIl])
  @@map("fatto_in_uscita")
  @@schema("aula_studio")
}

// ---------------------------------------------------------------------------
// Schema "cancellazione" — il registro delle cancellazioni account (V5/SE3).
// ---------------------------------------------------------------------------

/// Registro delle richieste di cancellazione (architecture-doc §7).
///
/// Contiene SOLO: identificativo, istanti, stato per detentore, esito della
/// verifica. Nessun altro dato personale — niente email, nomi, contenuti, e
/// nemmeno gli identificatori anonimi (una mappa id → pseudonimo sarebbe
/// pseudonimizzazione, non cancellazione: esclusione 19 di V5).
///
/// La riga NON viene eliminata al completamento: dopo qualunque ripristino da
/// backup il registro è ri-applicato automaticamente, e per ri-applicare
/// servono utente_id e scadenza. Viene eliminata SOLO se la richiesta è
/// annullata da un nuovo accesso entro la grazia: un utente attivo non deve
/// figurare qui, e una voce «annullata ma conservata» cancellerebbe i dati di
/// un utente vivo alla prima ri-applicazione.
///
/// Nessuna foreign key verso altri schemi: fra contesti non si attraversano
/// gli schemi, e questa riga deve sopravvivere all'utente che nomina.
model RichiestaDiCancellazione {
  /// Id dell'utente. Chiave primaria: una sola richiesta per utente.
  utenteId    String   @id
  richiestaIl DateTime @default(now())
  /// Fine della grazia (richiestaIl + 14 giorni). La catena parte da qui.
  /// Memorizzato e non derivato: la query del worker è un range su un indice,
  /// e i test lo invecchiano senza mock dell'orologio.
  eseguibileDal DateTime
  /// Termine massimo di V5 (richiestaIl + 30 giorni).
  scadenza      DateTime

  // Stato per detentore: null = da eseguire, valorizzato = quando è riuscito
  // la prima volta. Un timestamp è insieme stato e traccia.
  // >>> PUNTO DA AGGIORNARE A OGNI NUOVO DETENTORE (con DETENTORI_CENSITI) <<<
  bachecaAnonimizzataIl    DateTime?
  gruppiLiberatiIl         DateTime?
  auleStudioLiberateIl     DateTime?
  segnalazioniEliminateIl  DateTime?
  profiloEliminatoIl       DateTime?
  accessoEliminatoIl       DateTime?

  // Verifica del residuo (SE3): l'ultima eseguita e la prima TOTALE pulita.
  ultimaVerificaIl    DateTime?
  ultimoResiduoRecord Int?
  ultimoResiduoFile   Int?
  /// Prima verifica con esito TOTALE e residuo 0+0: è la prova di SE3 e il
  /// criterio di «richiesta completata». Non si azzera mai — la verità
  /// corrente sta in ultimaVerificaIl/ultimoResiduo*.
  verificataATotaleIl DateTime?

  aggiornatoIl DateTime @default(now()) @updatedAt

  @@index([eseguibileDal])
  @@index([verificataATotaleIl])
  @@map("richiesta_di_cancellazione")
  @@schema("cancellazione")
}

/// ---------------------------------------------------------------------------
/// SEGNALAZIONE — la coda che qualcuno guarda.
/// ---------------------------------------------------------------------------

/// Cosa si può segnalare. Elenco chiuso: i messaggi d'aula restano fuori per
/// ora — sono spazi a moderazione propria — e aggiungerli è una decisione,
/// non un dettaglio.
enum TipoDiSoggettoSegnalato {
  POST
  COMMENTO

  @@map("tipo_di_soggetto_segnalato")
  @@schema("segnalazione")
}

/// Perché. Elenco chiuso, come gli eventi di prodotto e per lo stesso motivo:
/// un campo libero diventa in poche settimane un canale di comunicazione da
/// presidiare, e nomi simili rendono la coda illeggibile.
enum MotivoDiSegnalazione {
  SPAM
  MOLESTIE
  CONTENUTO_INAPPROPRIATO

  @@map("motivo_di_segnalazione")
  @@schema("segnalazione")
}

/// Una segnalazione: chi, cosa, perché, quando. Niente altro.
///
/// **Il contenuto segnalato non entra qui** — la riga riferisce il soggetto
/// per identità (nessuna FK fra schemi), e l'estratto viaggia solo
/// nell'email al supporto: conservarlo farebbe di questo schema un detentore
/// di contenuti di terzi senza via di cancellazione.
///
/// Il vincolo unico rende la doppia segnalazione un'operazione senza effetto
/// (e senza seconda email): la stessa persona sullo stesso soggetto conta uno.
model Segnalazione {
  id           String                  @id @default(uuid())
  segnalanteId String
  tipo         TipoDiSoggettoSegnalato
  soggettoId   String
  motivo       MotivoDiSegnalazione
  creatoIl     DateTime                @default(now())

  @@unique([segnalanteId, tipo, soggettoId])
  @@index([creatoIl])
  @@map("segnalazione")
  @@schema("segnalazione")
}
