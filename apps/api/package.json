{
  "name": "@prome/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Prome \u2014 monolite modulare NestJS (Fastify). Stessa codebase per le due unit\u00e0 di esecuzione: app (HTTP) e worker (meccanismi ricorrenti), scelte a runtime con APP_ROLE.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "APP_ROLE=worker nest start --watch",
    "build": "pnpm --filter @prome/api^... build && prisma generate && nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "openapi:emit": "nest build && node dist/scripts/genera-openapi.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "@prome/contracts": "workspace:*",
    "@prome/i18n": "workspace:*",
    "better-auth": "^1.6.26",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "nestjs-i18n": "^10.5.0",
    "nodemailer": "^9.0.5",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "mjs",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.(ts|mjs|js)$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "CommonJS",
            "esModuleInterop": true
          },
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!(better-auth|@better-auth|better-call|jose|nanostores|@noble|uncrypto|kysely|defu))"
    ]
  }
}
