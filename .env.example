# Copia in .env (root) — l'API fa fail-fast all'avvio se manca un valore obbligatorio
DATABASE_URL=postgresql://prome:prome@localhost:6400/prome
# Ruolo dell'unità di esecuzione: "app" (comandi/letture sincrone) | "worker" (meccanismi ricorrenti, recapito fatti)
APP_ROLE=app
PORT=3600
NODE_ENV=development

# Segreto del fornitore di identità: almeno 32 caratteri. Cambiarlo invalida
# tutte le sessioni in corso (è il modo per revocarle se trapela).
BETTER_AUTH_SECRET=cambia-questo-segreto-con-almeno-32-caratteri
BETTER_AUTH_URL=http://localhost:3600
# Come esce il codice OTP. "sviluppo" lo scrive nei log e non manda email:
# vietato in produzione, l'avvio si ferma.
CANALE_EMAIL=sviluppo
# Origini dei client che possono chiamare l'API, separate da virgola.
ORIGINI_CONSENTITE=http://localhost:3500
# Dove l'archivio locale scrive i file. Esiste finché il fornitore di
# archiviazione non è scelto: è l'unica variabile che rivela quale adattatore
# è in uso, e sparirà con lui.
ARCHIVIO_LOCALE_PERCORSO=./.archivio
