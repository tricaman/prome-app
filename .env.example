# Copia in .env (root) — l'API fa fail-fast all'avvio se manca un valore obbligatorio
DATABASE_URL=postgresql://prome:prome@localhost:5432/prome
# Ruolo dell'unità di esecuzione: "app" (comandi/letture sincrone) | "worker" (meccanismi ricorrenti, recapito fatti)
APP_ROLE=app
PORT=3001
NODE_ENV=development
